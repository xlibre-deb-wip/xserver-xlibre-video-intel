-#endif
+		sna_setup_provider(scrn);
 	} else {
 		if (!sna_mode_fake_init(sna))
 			return false;
@@ -3200,6 +3209,9 @@ sna_mode_close(struct sna *sna)
 	while (sna_mode_has_pending_events(sna))
